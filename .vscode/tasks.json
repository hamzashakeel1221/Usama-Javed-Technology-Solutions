{
  // Ctrl+Shift+B starts the API (http://localhost:8787) and the website (http://localhost:5173).
  // First time only: run `npm install` in this folder and copy .dev.vars.example to .dev.vars.
  // Stop a server with Ctrl+C in its terminal, or "Tasks: Terminate Task".
  "version": "2.0.0",
  "tasks": [
    {
      "label": "UJ: API",
      "type": "shell",
      "command": "npm run dev:api",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": { "panel": "dedicated", "reveal": "always", "group": "uj", "clear": true },
      "problemMatcher": {
        "owner": "uj-api",
        "pattern": { "regexp": "^\\s*(✘|ERROR):?\\s+(.*)$", "severity": 1, "message": 2 },
        "background": { "activeBegins": true, "beginsPattern": "wrangler|Migrations", "endsPattern": "Ready on" }
      }
    },
    {
      "label": "UJ: Website",
      "type": "shell",
      "command": "npm run dev -- --host 127.0.0.1",
      "options": { "cwd": "${workspaceFolder}/uj-web" },
      "isBackground": true,
      "presentation": { "panel": "dedicated", "reveal": "always", "group": "uj", "clear": true },
      "problemMatcher": {
        "owner": "uj-web",
        "pattern": { "regexp": "^\\s*(ERROR|Error):?\\s+(.*)$", "severity": 1, "message": 2 },
        "background": { "activeBegins": true, "beginsPattern": "VITE|vite|>", "endsPattern": "Local:|ready in" }
      }
    },
    {
      "label": "UJ: Run website",
      "dependsOn": ["UJ: API", "UJ: Website"],
      "dependsOrder": "parallel",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}

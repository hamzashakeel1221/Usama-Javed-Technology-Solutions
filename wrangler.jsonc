{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uj-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // The built website (uj-web → dist). Pages like /about are served from dist/about/index.html.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // The Worker handles the API, uploaded photos and the admin app; everything else is a static file
    "run_worker_first": ["/api/*", "/uploads/*", "/admin", "/admin/*"]
  },

  // Created automatically on the first deploy; tables come from migrations/
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uj-website",
      "migrations_dir": "migrations"
    }
  ],

  "observability": { "enabled": true },
  "keep_vars": true
}
